{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AgentDock",
  "mainBinaryName": "skills-manager",
  "version": "1.40.0",
  "identifier": "com.agentskills.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentDock",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRUYwMTBDOEQ3MDdEODAKUldTQWZYQ05EQUh2Mm0wNDZtNm5VYWJpbjRaZVJQRUhrQ2tkOXc3MHBWZ2VaREo0OVd3WEU3d0oK",
      "endpoints": [
        "https://github.com/Zestful-ss/agentdock/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "agentskills",
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "08c191c4-bdbb-5964-9f50-bc2b2edafd1a"
      },
      "nsis": {
        "startMenuFolder": "skills-manager",
        "installerHooks": "windows/agentdock-migration.nsh"
      }
    },
    "linux": {
      "deb": {
        "conflicts": ["skills-manager"],
        "replaces": ["skills-manager"]
      },
      "rpm": {
        "conflicts": ["skills-manager"],
        "obsoletes": ["skills-manager"]
      }
    },
    "macOS": {
      "bundleName": "skills-manager",
      "minimumSystemVersion": "10.15"
    }
  }
}
