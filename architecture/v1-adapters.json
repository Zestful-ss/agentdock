{
  "principle": "Harnesses are discovery sources, not deployment targets.",
  "canonical": {
    "userSkills": "%USERPROFILE%\\.agents\\skills",
    "projectSkills": "<repo>\\.agents\\skills"
  },
  "adapters": [
    {
      "id": "codex",
      "name": "Codex",
      "repo": "https://github.com/openai/codex",
      "platform": "windows",
      "nativeConsumer": true,
      "skills": {
        "user": ["%USERPROFILE%\\.codex\\skills"],
        "project": [".codex/skills"],
        "system": ["%USERPROFILE%\\.codex\\skills\\.system"]
      },
      "mcp": {
        "user": ["%USERPROFILE%\\.codex\\config.toml"]
      }
    },
    {
      "id": "claude_code",
      "name": "Claude Code",
      "repo": "https://github.com/anthropics/claude-code",
      "platform": "windows",
      "nativeConsumer": false,
      "skills": {
        "user": ["%USERPROFILE%\\.claude\\skills"],
        "project": [".claude/skills"]
      },
      "mcp": {
        "user": ["%APPDATA%\\Claude\\claude_desktop_config.json", "%USERPROFILE%\\.claude.json"]
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "repo": "https://github.com/anomalyco/opencode",
